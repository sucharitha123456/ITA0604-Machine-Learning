        "\n",
        "df = pd.read_csv(StringIO(data))\n",
        "\n",
        "attributes = df.iloc[:, :-1].values\n",
        "target = df.iloc[:, -1].values\n",
        "\n",
        "# Initialize the most specific hypothesis\n",
        "hypothesis = ['0'] * len(attributes[0])\n",
        "\n",
        "for i, example in enumerate(attributes):\n",
        "    if target[i] == 'Yes':\n",
        "        for j in range(len(hypothesis)):\n",
        "            if hypothesis[j] == '0':\n",
        "                hypothesis[j] = example[j]\n",
        "            elif hypothesis[j] != example[j]:\n",
        "                hypothesis[j] = '?'\n",
        "        print(\"After example\", i + 1, \":\", hypothesis)\n",
        "\n",
        "print(\"\\nFinal Hypothesis:\", hypothesis)"
