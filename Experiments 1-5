        "# Candidate-Elimination Algorithm\n",
        "\n",
        "import pandas as pd\n",
        "from io import StringIO\n",
        "\n",
        "data = \"\"\"Sky,AirTemp,Humidity,Wind,Water,Forecast,EnjoySport\n",
        "Sunny,Warm,Normal,Strong,Warm,Same,Yes\n",
        "Sunny,Warm,High,Strong,Warm,Same,Yes\n",
        "Rainy,Cold,High,Strong,Warm,Change,No\n",
        "Sunny,Warm,High,Strong,Cool,Change,Yes\"\"\"\n",
        "\n",
        "df = pd.read_csv(StringIO(data))\n",
        "\n",
        "X = df.iloc[:, :-1].values.tolist()\n",
        "Y = df.iloc[:, -1].tolist()\n",
        "\n",
        "n = len(X[0])\n",
        "S = ['0'] * n\n",
        "G = [['?'] * n]\n",
        "\n",
        "def covers(h, x):\n",
        "    return all(a == '?' or a == v for a, v in zip(h, x))\n",
        "\n",
        "def more_general(h1, h2):\n",
        "    return all(a == '?' or a == b for a, b in zip(h1, h2))\n",
        "\n",
        "def minimal_generalizations(h, x):\n",
        "    result = []\n",
        "    new_h = h.copy()\n",
        "    for i in range(n):\n",
        "        if new_h[i] == '0':\n",
        "            new_h[i] = x[i]\n",
        "        elif new_h[i] != x[i]:\n",
        "            new_h[i] = '?'\n",
        "    result.append(new_h)\n",
        "    return result\n",
        "\n",
        "def minimal_specializations(h, x, domains):\n",
        "    result = []\n",
        "    for i in range(n):\n",
        "        if h[i] == '?':\n",
        "            for value in domains[i]:\n",
        "                if value != x[i]:\n",
        "                    new_h = h.copy()\n",
        "                    new_h[i] = value\n",
        "                    result.append(new_h)\n",
        "    return result\n",
        "\n",
        "domains = [sorted(df[col].unique().tolist()) for col in df.columns[:-1]]\n",
        "\n",
        "for x, y in zip(X, Y):\n",
        "    if y == 'Yes':\n",
        "        G = [g for g in G if covers(g, x)]\n",
        "        if not covers(S, x):\n",
        "            S = minimal_generalizations(S, x)[0]\n",
        "        G = [g for g in G if more_general(g, S)]\n",
        "    else:\n",
        "        new_G = []\n",
        "        for g in G:\n",
        "            if covers(g, x):\n",
        "                new_G.extend(minimal_specializations(g, x, domains))\n",
        "            else:\n",
        "                new_G.append(g)\n",
        "        G = [\n",
        "            g for g in new_G\n",
        "            if more_general(g, S) and not any(\n",
        "                g != other and more_general(other, g) for other in new_G\n",
        "            )\n",
        "        ]\n",
        "\n",
        "    print(\"S =\", S)\n",
        "    print(\"G =\", G)\n",
        "    print()\n",
        "\n",
        "print(\"Final Specific Boundary S:\", S)\n",
        "print(\"Final General Boundary G:\", G)"
      ],
