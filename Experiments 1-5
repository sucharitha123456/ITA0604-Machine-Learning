        "# Artificial Neural Network using Backpropagation\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "np.random.seed(1)\n",
        "\n",
        "# Input dataset: XOR\n",
        "X = np.array([\n",
        "    [0, 0],\n",
        "    [0, 1],\n",
        "    [1, 0],\n",
        "    [1, 1]\n",
        "], dtype=float)\n",
        "\n",
        "Y = np.array([\n",
        "    [0],\n",
        "    [1],\n",
        "    [1],\n",
        "    [0]\n",
        "], dtype=float)\n",
        "\n",
        "# Network: 2 input neurons, 4 hidden neurons, 1 output neuron\n",
        "W1 = np.random.randn(2, 4)\n",
        "b1 = np.zeros((1, 4))\n",
        "W2 = np.random.randn(4, 1)\n",
        "b2 = np.zeros((1, 1))\n",
        "\n",
        "def sigmoid(x):\n",
        "    return 1 / (1 + np.exp(-np.clip(x, -500, 500)))\n",
        "\n",
        "learning_rate = 0.5\n",
        "\n",
        "for epoch in range(20000):\n",
        "    # Forward propagation\n",
        "    hidden = sigmoid(X @ W1 + b1)\n",
        "    output = sigmoid(hidden @ W2 + b2)\n",
        "\n",
        "    # Backpropagation\n",
        "    error = output - Y\n",
        "    delta_output = error * output * (1 - output)\n",
        "\n",
        "    delta_hidden = (delta_output @ W2.T) * hidden * (1 - hidden)\n",
        "\n",
        "    # Update weights and biases\n",
        "    W2 -= learning_rate * (hidden.T @ delta_output) / len(X)\n",
        "    b2 -= learning_rate * np.mean(delta_output, axis=0, keepdims=True)\n",
        "\n",
        "    W1 -= learning_rate * (X.T @ delta_hidden) / len(X)\n",
        "    b1 -= learning_rate * np.mean(delta_hidden, axis=0, keepdims=True)\n",
        "\n",
        "# Test the trained network\n",
        "hidden = sigmoid(X @ W1 + b1)\n",
        "predictions = sigmoid(hidden @ W2 + b2)\n",
        "\n",
        "print(\"Input | Actual | Predicted\")\n",
        "for i in range(len(X)):\n",
        "    predicted_class = int(predictions[i, 0] >= 0.5)\n",
        "    print(X[i].astype(int), \" | \", int(Y[i, 0]), \"    | \", predicted_class)\n",
        "\n",
        "print(\"\\nFinal Output Probabilities:\")\n",
        "print(np.round(predictions.flatten(), 3))"
